# Telegram API (https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890

# Client-facing bot token (@BotFather)
CLIENT_BOT_TOKEN=123456789:ABC...

# Team bot username (without @)
TEAM_BOT_USERNAME=KartataiFuturaBot

# Comma-separated Telegram user IDs allowed to use your bot
ALLOWED_USER_IDS=123456789

# Optional extra owner. Built-in admins stay active too.
OWNER_USER_ID=123456789

# Optional extra admins, comma-separated
ADMIN_USER_IDS=

# Session file name (without extension)
SESSION_NAME=kartatai_userbot

# Cloud deploy (Render/Railway/Fly). Local dev can ignore these.
# DATA_DIR=/data
# SESSION_DIR=/data/sessions
# TELEGRAM_SESSION_B64=
# TELEGRAM_CLIENT_SESSION_B64=
